{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets only: the app renders everything in the browser and has no server code
  "name": "tin",
  "account_id": "1c3baadb167aacf289943d4583e4782c",
  "compatibility_date": "2026-10-01",
  // tin.zirkelc.workers.dev and the preview URLs of each version stay on next to the custom domains
  "workers_dev": true,
  "preview_urls": true,
  // The custom domains create their DNS records and certificates on deploy
  "routes": [
    { "pattern": "tin.so", "custom_domain": true },
    { "pattern": "www.tin.so", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
